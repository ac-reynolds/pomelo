from collections.abc import Sequence

class Settings:
    def __init__(self, *, domain_box_opacity: float = 0.65,
                 sources: Sequence[Sequence[float]] | None = None,
                 preset: str = "smoke", thermal_buoyancy: bool = True,
                 density_dissipation: float = 0.2, camera_yaw: float = 0.0,
                 camera_pitch: float = -0.35, camera_zoom: float = 1.0,
                 pressure_iterations: int = 64) -> None: ...
    @property
    def domain_box_opacity(self) -> float: ...
    @domain_box_opacity.setter
    def domain_box_opacity(self, value: float) -> None: ...
    @property
    def sources(self) -> list[tuple[float, float, float]]: ...
    @sources.setter
    def sources(self, value: Sequence[Sequence[float]] | None) -> None: ...
    @property
    def preset(self) -> str: ...
    @preset.setter
    def preset(self, value: str) -> None: ...
    @property
    def thermal_buoyancy(self) -> bool: ...
    @thermal_buoyancy.setter
    def thermal_buoyancy(self, value: bool) -> None: ...
    @property
    def density_dissipation(self) -> float: ...
    @density_dissipation.setter
    def density_dissipation(self, value: float) -> None: ...
    @property
    def camera_yaw(self) -> float: ...
    @camera_yaw.setter
    def camera_yaw(self, value: float) -> None: ...
    @property
    def camera_pitch(self) -> float: ...
    @camera_pitch.setter
    def camera_pitch(self, value: float) -> None: ...
    @property
    def camera_zoom(self) -> float: ...
    @camera_zoom.setter
    def camera_zoom(self, value: float) -> None: ...
    @property
    def pressure_iterations(self) -> int: ...
    @pressure_iterations.setter
    def pressure_iterations(self, value: int) -> None: ...
    def __repr__(self) -> str: ...

def default_settings() -> Settings: ...
def run(settings: Settings) -> None: ...
