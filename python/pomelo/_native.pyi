from collections.abc import Sequence

class Settings:
    def __init__(self, *, domain_box_opacity: float = 0.65,
                 sources: Sequence[Sequence[float]] | None = None) -> None: ...
    @property
    def domain_box_opacity(self) -> float: ...
    @domain_box_opacity.setter
    def domain_box_opacity(self, value: float) -> None: ...
    @property
    def sources(self) -> list[tuple[float, float, float]]: ...
    @sources.setter
    def sources(self, value: Sequence[Sequence[float]] | None) -> None: ...
    def __repr__(self) -> str: ...

def default_settings() -> Settings: ...
def run(settings: Settings) -> None: ...
